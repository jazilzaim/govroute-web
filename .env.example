# Copy this file to .env and fill in your server-side Firebase credentials.
# Keep the FIREBASE_ prefix (do NOT use VITE_FIREBASE_) so keys are never bundled into browser JS.
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""
FIREBASE_MEASUREMENT_ID=""
