# Copy this file to .env and fill in your server-side Firebase credentials.
# Keep the FIREBASE_ prefix (do NOT use VITE_FIREBASE_) so keys are never bundled into browser JS.
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""
FIREBASE_MEASUREMENT_ID=""

# Client-side Supabase Auth credentials (copy to .env.local and fill in from Supabase Project Settings -> API)
# Only use the public anon / publishable key here; never expose the service_role key in client env vars.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

